{:paths ["src" "resources"]

 :deps
 {org.clojure/clojure           {:mvn/version "1.12.6"}

  ;; hive-addon — IAddon protocol + command contribution to the host's `code` tool
  io.github.hive-agi/hive-addon {:mvn/version "1.1.7"}

  ;; hive-dsl — Result monad
  io.github.hive-agi/hive-dsl   {:mvn/version "0.5.37"}

  metosin/malli                 {:mvn/version "0.20.3"}

  ;; `elm make --report=json` decoding
  org.clojure/data.json         {:mvn/version "2.5.2"}

  com.taoensso/timbre           {:mvn/version "6.8.0"}}

 :aliases
 {:test
  {:extra-paths ["test" "test/resources"]
   :extra-deps {io.github.cognitect-labs/test-runner
                {:git/tag "v0.5.1" :git/sha "dfb30dd"}
                org.clojure/test.check {:mvn/version "1.1.3"}}
   :main-opts ["-m" "cognitect.test-runner" "-e" ":integration"]}

  ;; Needs a real `elm` binary; see README.
  :integration
  {:extra-paths ["test" "test/resources"]
   :extra-deps {io.github.cognitect-labs/test-runner
                {:git/tag "v0.5.1" :git/sha "dfb30dd"}
                org.clojure/test.check {:mvn/version "1.1.3"}}
   :main-opts ["-m" "cognitect.test-runner" "-i" ":integration"]}

  ;; Release entrypoint (clojure -T:build <task>), from the published
  ;; hive-build.api. No per-repo build script.
  :build
  {:deps {io.github.hive-agi/hive-build {:mvn/version "0.1.28"}}
   :jvm-opts ["-Xmx1g"]
   :ns-default hive-build.api}

  :nrepl
  {:extra-paths ["test" "test/resources"]
   :extra-deps {nrepl/nrepl       {:mvn/version "1.8.0"}
                cider/cider-nrepl {:mvn/version "0.62.2"}}
   :main-opts ["-m" "nrepl.cmdline"
               "--middleware" "[cider.nrepl/cider-middleware]"]}}}
